{
	"name": "df_join",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_customer_file",
						"type": "DatasetReference"
					},
					"name": "CUSTOMER"
				},
				{
					"dataset": {
						"referenceName": "ds_account_file",
						"type": "DatasetReference"
					},
					"name": "ACCOUNT"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_cust_acct_tgt",
						"type": "DatasetReference"
					},
					"name": "LoanAnalysis",
					"rejectedDataLinkedService": {
						"referenceName": "ls_ablob_velansa",
						"type": "LinkedServiceReference"
					}
				},
				{
					"dataset": {
						"referenceName": "ds_cust_acct_reject",
						"type": "DatasetReference"
					},
					"name": "LoanReject"
				}
			],
			"transformations": [
				{
					"name": "JOIN"
				},
				{
					"name": "SPLIT"
				}
			],
			"scriptLines": [
				"source(output(",
				"          CUST_ID as integer,",
				"          CUST_NAME as string,",
				"          AGE as integer,",
				"          GENDER as string,",
				"          CITY as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> CUSTOMER",
				"source(output(",
				"          CUST_ID as integer,",
				"          ACCOUNT_NUMBER as string,",
				"          ACCOUNT_TYPE as string,",
				"          ACCOUNT_OPEN_DATE as string,",
				"          ACCOUNT_CLOSE_DATE as string,",
				"          DORMANCY_STATUS as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> ACCOUNT",
				"CUSTOMER, ACCOUNT join(CUSTOMER@CUST_ID == ACCOUNT@CUST_ID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> JOIN",
				"JOIN split(AGE >= 25 && AGE <= 45,",
				"     disjoint: false) ~> SPLIT@(toTgt, toReject)",
				"SPLIT@toTgt sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> LoanAnalysis",
				"SPLIT@toReject sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> LoanReject"
			]
		}
	}
}